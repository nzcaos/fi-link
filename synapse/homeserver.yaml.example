# Synapse homeserver config — TEMPLATE.
#
# Copy this to synapse/homeserver.yaml on the VM and fill the __PLACEHOLDER__
# values. synapse/homeserver.yaml is gitignored (it carries secrets). This
# mirrors the .env.example -> .env convention.
#
# Synapse does NOT expand ${ENV} variables inside this file, so the DB password
# and shared secrets are written here literally (the file lives only on the VM,
# never in git). See docs/matrix-phase0-operator.md for the full setup,
# including signing-key generation (run `generate` once before `run`).
#
# Decisions baked in (docs/matrix-implementation-plan.md):
#   - server_name = fichtelink.caos.cloud (UNCHANGEABLE after first start)
#   - federation ON; class rooms stay closed via invite-only + invite PL=100
#   - public registration OFF; accounts only via the admin shared-secret API
#   - single 8008 listener (client + federation) behind the Apache reverse proxy
#   - separate `synapse` DB in the existing Postgres instance, collation C

server_name: "fichtelink.caos.cloud"
pid_file: /data/homeserver.pid
report_stats: false

# Single HTTP listener for BOTH client and federation traffic. TLS is terminated
# by the Apache reverse proxy on a separate host; Synapse speaks plain HTTP here
# and trusts X-Forwarded-* (x_forwarded: true). 8448 is never opened — federation
# arrives on 443 via the .well-known/matrix/server delegation.
listeners:
  - port: 8008
    type: http
    x_forwarded: true
    bind_addresses: ['0.0.0.0']
    resources:
      - names: [client, federation]
        compress: false

database:
  name: psycopg2
  args:
    user: synapse
    password: "__SYNAPSE_DB_PASSWORD__"
    database: synapse
    host: db
    port: 5432
    cp_min: 5
    cp_max: 10

# Public registration OFF — accounts are created ONLY by our Django server via
# the admin shared-secret registration API. Keep this secret in sync with
# MATRIX_ADMIN_SHARED_SECRET in .env (they are the same value).
enable_registration: false
registration_shared_secret: "__MATRIX_ADMIN_SHARED_SECRET__"

# Privacy / pseudonymity defense-in-depth (matrix-architecture.md §4). The real
# protection is the source-side pseudonymous displayname; these close the
# profile-leak gaps over the client-server API.
require_auth_for_profile_requests: true
limit_profile_requests_to_users_who_share_rooms: true
include_profile_data_on_invite: false

# Signing key + secrets generated by the one-time `generate` step (operator
# checklist). Leave these paths; `generate` writes the files next to this config.
signing_key_path: "/data/fichtelink.caos.cloud.signing.key"
macaroon_secret_key: "__MACAROON_SECRET_KEY__"
form_secret: "__FORM_SECRET__"

# Media store inside the host-mounted /data volume.
media_store_path: "/data/media_store"

# Keep federation ON (the whole point: parents can use Matrix freely). Class
# rooms are protected structurally, not by disabling federation. If you ever
# want to restrict which servers may federate, add a federation_domain_whitelist
# here — but that also blocks parents' own homeservers, so leave it open for the
# pilot.

trusted_key_servers:
  - server_name: "matrix.org"
