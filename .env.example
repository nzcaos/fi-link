# Django
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=change-me

# Phase 0: leave on so the scaffold welcome page is reachable.
# Production deployment must set this to False.
DJANGO_DEBUG=True

# Comma-separated. Must include the public hostname behind the reverse proxy.
ALLOWED_HOSTS=fichtelink.caos.cloud,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://fichtelink.caos.cloud

# At-rest encryption for LIST_RECORD_VALUE (wired in Phase 1).
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# LOSING THIS KEY MAKES ALL STORED LIST-RECORD VALUES UNRECOVERABLE. Back it up off-host.
FERNET_KEY=change-me

# WebAuthn relying-party identity (Phase 2). RP_ID is the bare hostname (no scheme),
# RP_ORIGIN is the full URL the browser sees. These MUST match what the browser
# sends — see CLAUDE.md / "Architecture decisions (authentication) / HTTPS, RP config".
RP_ID=fichtelink.caos.cloud
RP_ORIGIN=https://fichtelink.caos.cloud
RP_NAME=Fichtelink

# Outbound mail for activation/release links (Phase 2 onward). Falls back to console
# backend when DJANGO_EMAIL_BACKEND is unset, which is fine for local development.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Fichtelink <noreply@caos.cloud>

# PostgreSQL
POSTGRES_DB=fichtelink
POSTGRES_USER=fichtelink
POSTGRES_PASSWORD=change-me

# Mail provider (Phase 4 SMTP, Phase 5a IMAP IDLE consumer).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Almost always True for production providers; leave on.
IMAP_USE_SSL=True
# Re-IDLE before the server's 30-min kick (RFC 2177). Seconds.
IMAP_IDLE_TIMEOUT=1740
# Fallback poll while IDLE'ing — catches missed notifications. Seconds.
IMAP_FALLBACK_POLL_INTERVAL=300
# Phase 5b retention. Processed mail is EXPUNGE'd from IMAP after this many days.
IMAP_EXPUNGE_GRACE_DAYS=7
# Local Inbound/Outbound metadata pruned after this many days (30–90).
MAIL_METADATA_RETENTION_DAYS=90

SMTP_HOST=
# Port 587 + SMTP_USE_TLS=True (STARTTLS) is the common submission path.
# For an implicit-TLS endpoint use port 465 + SMTP_USE_SSL=True instead;
# SMTP_USE_SSL takes precedence and forces STARTTLS off.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
# Seconds before an SMTP socket op aborts — keeps a bad endpoint from hanging.
SMTP_TIMEOUT=30

# Domain on which list addresses are received (e.g. caos.cloud -> 5a@caos.cloud).
MAIL_DOMAIN=caos.cloud

# Host port the web container is published on (firewall must restrict to the proxy host).
WEB_PORT=8000

# --- Matrix messenger integration (docs/matrix-implementation-plan.md) ---
# OFF until Synapse (Phase 0) is up and the federation tester is green. Every
# Matrix code path is guarded by this flag.
MATRIX_ENABLED=False
# Synapse is reachable ONLY inside the Docker network — never expose 8008/8448.
MATRIX_BASE_URL=http://synapse:8008
# Unchangeable after first start. Determines @user:<server_name> ids.
MATRIX_SERVER_NAME=fichtelink.caos.cloud
# = homeserver.yaml `registration_shared_secret`. Generate a long random value:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Drives the admin shared-secret registration API. NEVER commit a real value.
MATRIX_ADMIN_SHARED_SECRET=change-me
MATRIX_HTTP_TIMEOUT=30
# Synapse's own PostgreSQL database. We use a SEPARATE database `synapse` in the
# EXISTING db container (collation C, created from template0 — see the operator
# checklist), not a second instance. Consumed by synapse/homeserver.yaml.
SYNAPSE_DB_PASSWORD=change-me
# Host port Synapse's 8008 is published on (firewall must restrict to the proxy
# host, exactly like WEB_PORT). 8448 is intentionally NOT mapped — federation
# runs through the Apache .well-known delegation on 443.
SYNAPSE_PORT=8008
