# Django
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=change-me

# Phase 0: leave on so the scaffold welcome page is reachable.
# Production deployment must set this to False.
DJANGO_DEBUG=True

# Comma-separated. Must include the public hostname behind the reverse proxy.
ALLOWED_HOSTS=fichtelink.caos.cloud,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://fichtelink.caos.cloud

# At-rest encryption for LIST_RECORD_VALUE (wired in Phase 1).
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# LOSING THIS KEY MAKES ALL STORED LIST-RECORD VALUES UNRECOVERABLE. Back it up off-host.
FERNET_KEY=change-me

# PostgreSQL
POSTGRES_DB=fichtelink
POSTGRES_USER=fichtelink
POSTGRES_PASSWORD=change-me

# Mail provider (used from Phase 4 / 5 onward; kept here for completeness)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Domain on which list addresses are received (e.g. caos.cloud -> 5a@caos.cloud).
MAIL_DOMAIN=caos.cloud

# Host port the web container is published on (firewall must restrict to the proxy host).
WEB_PORT=8000
